resource_group_name  = "rg-data-prod"
location             = "eastus"
sql_server_name      = "sql-prod-eus"
target_database_name = "AppDb"

# Must be >=5 minutes in the future on first apply. RFC3339 UTC.
schedule_start_time = "2026-05-01T02:00:00Z"

truncation_sql     = "TRUNCATE TABLE dbo.StagingEvents;"
schedule_frequency = "Day"
schedule_interval  = 1

tags = {
  owner = "data-platform"
  env   = "prod"
}
